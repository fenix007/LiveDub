# Обязательно: ключ Deepgram с правами Member или выше (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Опционально: LLM-перевод через любой OpenAI-совместимый API
# (OpenAI, OpenRouter, свой шлюз). Если пусто — только встроенный переводчик Chrome.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini

# Опционально: Gemini через gemini-gateway. Несколько ключей — через запятую.
# Ключи остаются на сервере. Можно использовать GEMINI_API_KEY для одного ключа.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_RPM=15
# GEMINI_TPM=250000
# GEMINI_RPD=500
# Лимит черновых запросов; финальные не ограничиваются.
# GEMINI_DRAFT_RPM=6

# Опционально: DeepSeek Flash. Ключ хранится только на сервере.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_TIMEOUT_MS=10000

# Опционально: русский голос Yandex SpeechKit (ключ сервисного аккаунта).
YANDEX_SPEECHKIT_API_KEY=

# Опционально: отдельный ключ Yandex Translate. Если пусто, используется ключ SpeechKit.
# Сервисному аккаунту нужны роль ai.translate.user и scope yc.ai.translate.execute.
YANDEX_TRANSLATE_API_KEY=
# YANDEX_TRANSLATE_TIMEOUT_MS=5000

PORT=3000
